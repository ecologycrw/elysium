{
  "stryker-config": {
    "project": "Elysium.Classic.Server.csproj",
    "test-runner": "mtp",
    "reporters": ["progress", "html", "markdown"],
    "thresholds": { "high": 90, "low": 80, "break": 80 },
    "ignore-methods": [
      "ConfigureAwait",
      "ArgumentNullException.ThrowIfNull",
      "LogConnectionFailed",
      "LogJoined",
      "LogLeft",
      "LogListening",
      "LogLoginRefused",
      "LogProtocolViolation",
      "LogStarted",
      "LogStopped"
    ]
  }
}
