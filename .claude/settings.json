{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run --project tools/Elysium.Checks:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c fatia/:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin fatia/:*)",
      "Bash(git push origin fatia/:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(.githooks/**)",
      "Edit(.github/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(**/Directory.Build.props)",
      "Edit(Directory.Packages.props)",
      "Edit(**/.editorconfig)",
      "Edit(global.json)",
      "Edit(src/BannedSymbols.txt)",
      "Edit(tools/Elysium.Checks/**)",
      "Edit(tests/Elysium.Architecture.Tests/**)",
      "Edit(tests/hooks/**)",
      "Edit(docs/VISION.md)",
      "Edit(docs/ROADMAP.md)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.ps1\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
